---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	summary: string;
	href: string;
	image: ImageMetadata;
	author: string;
	authorPhoto: ImageMetadata;
	authorPhotoAlt: string;
	date: string;
}

const { title, summary, href, image, author, authorPhoto, authorPhotoAlt, date } = Astro.props;
---

<a href={href} class="blog-item">
	<div class="blog-image-wrap">
		<Image class="blog-image" src={image} alt="" widths={[380, 760]} sizes="(max-width: 767px) 90vw, 380px" />
	</div>
	<div class="blog-content">
		<h3>{title}</h3>
		<p class="summary">{summary}</p>
		<div class="profile-block">
			<Image class="profile-picture" src={authorPhoto} alt={authorPhotoAlt} width={50} />
			<div>
				<div class="author">{author}</div>
				<div class="date">{date}</div>
			</div>
		</div>
	</div>
</a>

<style>
	.blog-item {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 16px 40px;
		width: 100%;
		margin-bottom: 40px;
		padding: 20px;
		border-radius: 15px;
		background-color: var(--white);
		box-shadow: 0 22px 34px #0000000f;
		text-decoration: none;
	}
	.blog-image-wrap {
		border-radius: 10px;
		overflow: hidden;
	}
	.blog-image {
		display: block;
		width: 100%;
		height: auto;
	}
	.blog-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
	}
	h3 {
		margin: 0 0 10px;
		color: var(--midnight-blue);
		font-size: 24px;
		line-height: 140%;
	}
	.summary {
		margin: 0 0 24px;
		color: var(--dark-grey);
		font-size: 15px;
		line-height: 24px;
	}
	.profile-block {
		display: flex;
		align-items: center;
	}
	.profile-picture {
		margin-right: 10px;
		border-radius: 100px;
	}
	.author {
		margin-bottom: 4px;
		color: var(--midnight-blue);
		font-weight: 700;
	}
	.date {
		color: var(--dark-grey);
		line-height: 120%;
	}
	@media (max-width: 767px) {
		.blog-item {
			grid-template-columns: 1fr;
		}
	}
</style>
