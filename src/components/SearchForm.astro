---
import { Image } from 'astro:assets';
import searchIcon from '../assets/search-icon.svg';
import { withBase } from '../lib/url';

interface Props {
	/** "card" is the sidebar bar of the home page; "plain" is the bare form of the search page. */
	variant?: 'card' | 'plain';
	/** Id of the input; unique on the page. */
	id?: string;
}

const { variant = 'card', id = 'search' } = Astro.props;
const plain = variant === 'plain';
---

<form class:list={['search', { plain }]} action={withBase('/search')} method="get" role="search">
	<label class="sr-only" for={id}>Search</label>
	<input
		class="search-bar"
		id={id}
		name="query"
		type="search"
		maxlength="256"
		placeholder={plain ? 'Search…' : 'Search articles'}
		required
	/>
	{
		plain ? (
			<input type="submit" class="plain-button" value="Search" />
		) : (
			<div class="button-wrap">
				<button type="submit" class="search-button" aria-label="Search" />
				<Image class="search-icon" src={searchIcon} alt="" width={16} height={16} />
			</div>
		)
	}
</form>

<style>
	.search {
		position: relative;
		margin: 0;
	}
	.search-bar {
		display: block;
		width: 100%;
		height: 60px;
		margin-bottom: 40px;
		padding: 8px 80px 8px 20px;
		border: 0;
		border-radius: 15px;
		background-color: var(--white);
		color: var(--dark-grey);
		font: inherit;
		font-size: 15px;
		box-shadow: 0 12px 14px #0000000f;
	}
	.search-bar::placeholder {
		color: var(--dark-grey);
	}
	.button-wrap {
		position: absolute;
		top: 0;
		right: 0;
		height: 60px;
	}
	.search-button {
		width: 60px;
		height: 100%;
		padding: 0;
		border: 0;
		border-radius: 15px;
		background-color: var(--slate-blue);
		cursor: pointer;
	}
	.search-icon {
		position: absolute;
		top: 22px;
		left: 22px;
		pointer-events: none;
	}
	.plain .search-bar {
		display: block;
		width: 100%;
		height: 38px;
		margin: 0 0 10px;
		padding: 8px 12px;
		border: 1px solid #ccc;
		border-radius: 0;
		background-color: var(--white);
		color: #333;
		font-size: 14px;
		box-shadow: none;
	}
	.plain-button {
		padding: 9px 15px;
		border: 0;
		background-color: #3898ec;
		color: #fff;
		font: inherit;
		cursor: pointer;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
