---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import Header from '../components/Header.astro';
import bgShape01 from '../assets/bg-shape-01.svg';
import bgShape02 from '../assets/bg-shape-02.svg';
import { withBase } from '../lib/url';

interface Props {
	title: string;
	description?: string;
	/** Path of the page on the site, e.g. "/blog-article"; the canonical is built from it. */
	path?: string;
	ogImage?: string;
	/** A bare page without the header (the search results page). */
	plain?: boolean;
}

const { title, description, plain = false, path = Astro.url.pathname.replace(Astro.config.base.replace(/\/$/, ''), '') || '/', ogImage } = Astro.props;
const canonical = new URL(withBase(path), Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
		<link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48.png')} />
		<link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon-192.png')} />
		<link rel="icon" type="image/png" sizes="512x512" href={withBase('/favicon-512.png')} />
		<link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>
	<body style={`--bg-shape-01: url(${bgShape01.src}); --bg-shape-02: url(${bgShape02.src});`}>
		{
			!plain && (
				<header class="header">
					<Header />
					<slot name="hero" />
				</header>
			)
		}
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--white: #fff;
		--pink: #fb9acf;
		--slate-blue: #5c4ebd;
		--white-smoke: #f2f5f8;
		--midnight-blue: #202146;
		--dark-grey: #9899ad;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		color: #333;
		background-color: var(--white-smoke);
		font-family: 'DM Sans', sans-serif;
		font-size: 14px;
		line-height: 20px;
	}
	.stick-wrapper {
		position: sticky;
		top: 60px;
		/* keeps the sticky box from stretching to the height of its grid row (T07) */
		align-self: flex-start;
	}
	.header {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-height: 490px;
		padding: 100px 0;
		background-color: var(--slate-blue);
		background-image: var(--bg-shape-02), var(--bg-shape-01);
		background-position: 0 0, 100% 100%;
		background-repeat: no-repeat;
		background-size: contain, auto;
	}
	@media (max-width: 991px) {
		.header {
			background-image: var(--bg-shape-01);
			background-position: 100% 100%;
			background-size: auto;
		}
	}
	@media (max-width: 767px) {
		.header {
			background-image: none;
		}
	}
</style>
