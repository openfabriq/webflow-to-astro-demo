---
import Base from '../layouts/Base.astro';
---

<Base
	title="Cloneable Blog Template | Flowbase Cloneable"
	description="Clone the Cloneable Blog Template for free. Discover more Webflow resources and tools at Flowbase."
	path="/"
>
	<div slot="hero" class="title-centre">
		<h1>Our blog</h1>
		<div class="bar-big"><div class="bar-small"></div></div>
	</div>
</Base>

<style>
	.title-centre {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	h1 {
		margin: 0;
		max-width: 650px;
		color: var(--white);
		font-size: 60px;
		font-weight: 700;
		line-height: 1.1;
		text-align: center;
	}
	.bar-big {
		width: 220px;
		height: 5px;
		margin-top: 32px;
		border-radius: 100px;
		background-color: #ffffff1a;
	}
	.bar-small {
		width: 180px;
		height: 5px;
		border-radius: 100px;
		background-image: linear-gradient(to right, #fb9ac100, var(--pink));
	}
	@media (max-width: 767px) {
		h1 { font-size: 55px; }
	}
	@media (max-width: 479px) {
		h1 { font-size: 44px; }
	}
</style>
