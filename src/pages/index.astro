---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import SearchForm from '../components/SearchForm.astro';
import BlogCard from '../components/BlogCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { withBase } from '../lib/url';

const entry = await getEntry('articles', 'blog-article');
if (!entry) throw new Error('articles/blog-article is missing');
const { title, summary, author, authorPhoto, authorPhotoAlt, date, cardImages, featureImages } = entry.data;
const href = withBase('/blog-article');
---

<Base
	title="Cloneable Blog Template | Flowbase Cloneable"
	description="Clone the Cloneable Blog Template for free. Discover more Webflow resources and tools at Flowbase."
	path="/"
>
	<div slot="hero" class="title-centre">
		<h1>Our blog</h1>
		<div class="bar-big"><div class="bar-small"></div></div>
	</div>
	<main class="content-section">
		<div class="container">
			<div class="blog-grid">
				<div class="content-left">
					{cardImages.map((image) => (
						<BlogCard {title} {summary} {href} {image} {author} {authorPhoto} {authorPhotoAlt} {date} />
					))}
				</div>
				<aside class="content-right">
					<div class="stick-wrapper">
						<SearchForm />
						<Newsletter />
						<div class="featured-articles">
							<div class="title-large">Featured</div>
							<div class="featured-block">
								{featureImages.map((image) => <ArticleCard {title} {href} {image} />)}
							</div>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</main>
</Base>

<style>
	.content-section {
		padding: 132px 3%;
	}
	.container {
		width: 100%;
		max-width: 1110px;
		margin: 0 auto;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: 1fr 0.4fr;
		column-gap: 40px;
	}
	.content-left {
		display: flex;
		flex-direction: column;
		row-gap: 40px;
		align-items: center;
	}
	.title-large {
		margin-bottom: 20px;
		color: var(--midnight-blue);
		font-size: 20px;
		font-weight: 700;
		line-height: 130%;
	}
	.featured-block {
		margin-top: 10px;
	}
	.title-centre {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	h1 {
		margin: 0;
		max-width: 650px;
		color: var(--white);
		font-size: 60px;
		font-weight: 700;
		line-height: 1.1;
		text-align: center;
	}
	.bar-big {
		width: 220px;
		height: 5px;
		margin-top: 32px;
		border-radius: 100px;
		background-color: #ffffff1a;
	}
	.bar-small {
		width: 180px;
		height: 5px;
		border-radius: 100px;
		background-image: linear-gradient(to right, #fb9ac100, var(--pink));
	}
	@media (max-width: 991px) {
		.blog-grid {
			grid-template-columns: 1fr 0.6fr;
			column-gap: 22px;
		}
	}
	@media (max-width: 767px) {
		.content-section { padding: 92px 3%; }
		.blog-grid {
			grid-template-columns: 1fr;
			row-gap: 62px;
		}
		h1 { font-size: 55px; }
	}
	@media (max-width: 479px) {
		h1 { font-size: 44px; }
	}
</style>
