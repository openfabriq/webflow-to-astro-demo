---
import Base from '../layouts/Base.astro';
---

<Base
	title="Cloneable Blog Template | Flowbase Cloneable"
	description="Clone the Cloneable Blog Template for free. Discover more Webflow resources and tools at Flowbase."
	path="/"
>
	<div slot="hero" class="title-centre">
		<h1>Our blog</h1>
	</div>
</Base>

<style>
	.title-centre {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	h1 {
		margin: 0;
		max-width: 650px;
		color: var(--white);
		font-size: 60px;
		font-weight: 700;
		line-height: 1.1;
		text-align: center;
	}
	@media (max-width: 767px) {
		h1 { font-size: 55px; }
	}
	@media (max-width: 479px) {
		h1 { font-size: 44px; }
	}
</style>
