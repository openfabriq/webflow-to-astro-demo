---

<Base title="Search Results" path="/search" plain>
	<main class="container">
		<h1>Search results</h1>
		<SearchForm variant="plain" />
		<div class="results">
			{
				results.map((r) => (
					<div class="result">
						<span class="result-title">{r.title}</span>
						<div class="result-url">flowbase-blog-clone.webflow.io/sample-result</div>
						<p>{r.text}</p>
					</div>
				))
			}
		</div>
	</main>
</Base>

<style>
	.container {
		max-width: 940px;
		margin: 0 auto;
	}
	h1 {
		margin: 20px 0 38px;
		color: var(--white); /* white on white, as on the old page */
		font-size: 38px;
		font-weight: 700;
		line-height: 44px;
	}
	:global(body) {
		background-color: var(--white);
		font-family: Arial, sans-serif;
	}
	.result-title {
		color: #0000ee;
		text-decoration: underline;
	}
	.result-url {
		color: #333;
	}
	p {
		margin: 0 0 10px;
	}
</style>
